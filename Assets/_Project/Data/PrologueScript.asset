--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 221ecfc1f96f90a43adee1c3ff66457c, type: 3}
  m_Name: PrologueScript
  m_EditorClassIdentifier: BurningAnt::BurningAnt.Prologue.PrologueScript
  heroName: "\uC8FC\uC778\uACF5"
  loanSettings: {fileID: 11400000, guid: e7094fb4d601cb24b993ee44dcce1b1d, type: 2}
  nextScene: DayLoop
  lines:
  - speaker: 
    text: "\uD76C\uB9DD \uB300\uCD9C \uAE08\uC561\uC744 \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    portrait: {fileID: 2800000, guid: d85fd85624711b84e85fafc1eccb9cc4, type: 3}
    prop: 1
    footnote: 
  - speaker: '{hero}'
    text: "\uD55C\uB3C4 \uB05D\uAE4C\uC9C0\uC694. \uB124, \uD480\uB85C\uC694!"
    portrait: {fileID: 2800000, guid: c691d74e8f1a55a42ad5e42dfb74b3e1, type: 3}
    prop: 1
    footnote: 
  - speaker: "\uAC1C\uBBF8 \uB300\uCD9C"
    text: "\uC815\uB9D0 \uAD1C\uCC2E\uC73C\uC2DC\uACA0\uC5B4\uC694? \uC774\uC790\uB294 {period}\uB9C8\uB2E4 {rate}\uC529 \uBD99\uC5B4\uC694."
    portrait: {fileID: 2800000, guid: d85fd85624711b84e85fafc1eccb9cc4, type: 3}
    prop: 1
    footnote: 
  - speaker: '{hero}'
    text: "\uAD1C\uCC2E\uC544\uC694! \uAE08\uBC29 \uAC1A\uC744 \uAC70\uAC70\uB4E0\uC694!"
    portrait: {fileID: 2800000, guid: 45b36db38cb980348bb9b2668458a6b0, type: 3}
    prop: 2
    footnote: 
  - speaker: '{hero}'
    text: "\uC601\uC0C1\uC5D0\uC11C \uBD24\uC5B4. \uC8FC\uC2DD\uC740 \uC624\uB97C \uB54C \uC0AC\uC11C, \uB354 \uC624\uB97C \uB54C \uD314\uBA74 \uB41C\uB300!"
    portrait: {fileID: 2800000, guid: 98c14cbb3fcbd9946bb6ae21070beca2, type: 3}
    prop: 3
    footnote: 
  - speaker: '{hero}'
    text: "\uC774 \uB3C8\uC774\uBA74 \uD55C \uB2EC\u2026 \uC544\uB2C8, \uC77C\uC8FC\uC77C\uC774\uBA74 \uB450 \uBC30\uC57C! \uD6C4\uD6C4\u2026"
    portrait: {fileID: 2800000, guid: 98c14cbb3fcbd9946bb6ae21070beca2, type: 3}
    prop: 3
    footnote: "\u203B \uADF8\uB7F0 \uC601\uC0C1\uC740 \uB300\uBD80\uBD84 \uBB34\uB9AC\uC785\uB2C8\uB2E4"
  - speaker: '{hero}'
    text: "\u2026\uC5B4? \uC21C\uC790\uC0B0 $0? \uB0B4 \uB3C8\uC740 \uD558\uB098\uB3C4 \uC5C6\uB294 \uAC70\uC57C?"
    portrait: {fileID: 2800000, guid: 7f684a0fe79cd4a4f86f685da44c0c78, type: 3}
    prop: 4
    footnote: 
  - speaker: '{hero}'
    text: "\uBB34, \uBB34\uB9AC\uBB34\uB9AC\uBB34\uB9AC\u2026!"
    portrait: {fileID: 2800000, guid: 6063c4bb91a535e4fb4e5229af69add7, type: 3}
    prop: 4
    footnote: 
  - speaker: '{hero}'
    text: "\uC544, \uC544\uB2C8\uC57C! \uC9C0\uAE08\uBD80\uD130 \uBC8C\uBA74 \uB418\uC796\uC544!"
    portrait: {fileID: 2800000, guid: 819faa4a2ef275244a039a14bc0c2ab4, type: 3}
    prop: 4
    footnote: 
  - speaker: '{hero}'
    text: "\uBE5A\uC744 \uB2E4 \uAC1A\uB294 \uB0A0\uAE4C\uC9C0\u2026 \uAC00\uC988\uC544~!"
    portrait: {fileID: 2800000, guid: c691d74e8f1a55a42ad5e42dfb74b3e1, type: 3}
    prop: 5
    footnote: "{debt} \xB7 {period}\uB9C8\uB2E4 \uC774\uC790 {rate} \xB7 \uB2E4 \uAC1A\uC73C\uBA74 \uC2B9\uB9AC"
