/* 하루 루프 전체 화면 (디자인 기준: Docs/ui-mockup.png). 가운데 주식 창은 StockWindow.uxml/uss를 쓰고 여기서 카드 모양만 덧입힌다. */
.game-screen {
    --gs-page: #ECEAE3;
    --gs-card: #FFFFFF;
    --gs-panel: #F1EFE8;
    --gs-border: #D9D7CE;
    --gs-text: #2C2C2A;
    --gs-muted: #6B6A65;
    --gs-accent: #378ADD;
    --gs-up: #E24B4A;
    --gs-down: #378ADD;
    --gs-good: #1D9E75;

    flex-grow: 1;
    background-color: var(--gs-page);
    color: var(--gs-text);
    font-size: 18px;
}

.row { flex-direction: row; align-items: center; }
.row--spread { justify-content: space-between; }
.caption { font-size: 15px; color: var(--gs-muted); margin-right: 6px; }
.price-up { color: var(--gs-up); }
.price-down { color: var(--gs-down); }
.card { background-color: var(--gs-card); border-width: 1px; border-color: var(--gs-border); border-radius: 14px; }
.chip { font-size: 14px; padding: 2px 10px; border-radius: 8px; }
.chip--warning { background-color: #FAEEDA; color: #854F0B; }

/* 위 막대: 일차 · 단계 진행 · 빚 상환 */
.top-bar { flex-direction: row; align-items: center; height: 70px; margin: 18px 24px 0 24px; padding: 0 22px; }
.top-day { font-size: 28px; -unity-font-style: bold; margin-right: 18px; }
.steps { flex-grow: 1; flex-direction: row; }
.step {
    flex-grow: 1;
    flex-basis: 0;
    height: 38px;
    margin-right: 6px;
    border-radius: 9px;
    background-color: var(--gs-panel);
    color: var(--gs-muted);
    font-size: 16px;
    -unity-text-align: middle-center;
}
.step--done { color: #B4B2A9; }
.step--now { background-color: var(--gs-up); color: #FFFFFF; -unity-font-style: bold; }
.repay { width: 340px; margin-left: 18px; }
.repay-track { height: 10px; margin-top: 6px; border-radius: 5px; background-color: var(--gs-panel); }
.repay-fill { height: 10px; width: 0; border-radius: 5px; background-color: var(--gs-good); }

/* 몸통 */
.body { flex-grow: 1; flex-direction: row; }
.main-col { flex-grow: 1; padding: 16px 16px 18px 24px; }
.stock-window-host { flex-grow: 1; }

/* 주식 창을 카드 두 장(종목 리스트 / 상세)으로 보이게 */
.game-screen .stock-window { padding: 0; background-color: rgba(0, 0, 0, 0); }
.game-screen .stock-list-panel,
.game-screen .detail-panel {
    padding: 16px 18px;
    background-color: var(--gs-card);
    border-width: 1px;
    border-color: var(--gs-border);
    border-radius: 14px;
}
.game-screen .stock-list-panel { margin-right: 16px; }
.stock-group { font-size: 14px; color: var(--gs-muted); -unity-font-style: bold; margin: 10px 4px 4px 4px; }
.stock-item__badge { font-size: 12px; padding: 1px 7px; margin-left: 6px; border-radius: 7px; }
.stock-item__badge--news { background-color: #FAEEDA; color: #854F0B; }
.stock-item__badge--hint { background-color: #E6F1FB; color: #185FA5; }

/* 뉴스 띠 (차트 위) */
.news-band { margin-bottom: 10px; padding: 8px 14px; border-radius: 10px; background-color: #FAEEDA; }
.news-band--alert { background-color: var(--gs-up); }
.news-band--alert .news-band-title, .news-band--alert .news-band-line { color: #FFFFFF; }
.news-band-title { -unity-font-style: bold; font-size: 16px; color: #854F0B; }
.news-band-line { font-size: 15px; white-space: normal; color: #633806; margin-top: 3px; }
.news-band-line--chain { -unity-font-style: bold; }
.news-confirm { height: 34px; font-size: 15px; border-radius: 8px; }

/* 아래 아이템 칸 */
.item-bar { flex-direction: row; align-items: center; min-height: 96px; margin-top: 14px; padding: 10px 16px; }
.item-bar-title { -unity-font-style: bold; margin-right: 12px; }
.item-bar-list { flex-direction: row; flex-grow: 1; flex-wrap: wrap; }
.item-bar-hint { margin-left: 10px; white-space: normal; max-width: 360px; }
.item-slot {
    width: 150px;
    height: 64px;
    margin-right: 8px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--gs-border);
    background-color: #FAF9F5;
    padding: 4px 6px;
    justify-content: center;
}
.item-slot--off { opacity: 0.4; }
.item-slot__name { font-size: 15px; -unity-text-align: middle-center; white-space: normal; }
.item-slot__meta { font-size: 12px; color: var(--gs-muted); -unity-text-align: middle-center; }

/* 오른쪽 열: 오른쪽·아래 여백 없음 → 주인공이 화면 끝까지 */
.side-col { width: 380px; padding: 16px 0 0 0; margin-right: 24px; }
.status-card { padding: 14px 18px; }
.status-row { margin-bottom: 6px; }
.status-row--total { border-top-width: 1px; border-color: #E4E2DA; padding-top: 8px; margin-top: 2px; margin-bottom: 0; }
.status-value { -unity-font-style: bold; }
.status-value--small { font-size: 15px; }
.status-value--big { font-size: 20px; }
.hint-card { margin-top: 12px; padding: 10px 14px; max-height: 170px; }
.side-title { -unity-font-style: bold; font-size: 15px; margin-bottom: 4px; }
.hint-list { flex-grow: 1; }
.hint-line { font-size: 13px; white-space: normal; margin-bottom: 3px; color: var(--gs-muted); }

/* 주인공: 버튜버처럼 화면 바닥에 붙음 */
.character-area { flex-grow: 1; margin-right: -24px; }
.portrait {
    position: absolute;
    left: -120px;
    right: 0;
    top: 40px;
    bottom: 0;
    /* 실제 크기는 GameScreenController.characterScale로 코드에서 정한다 (화면 오른쪽 아래 기준) */
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}
.face { position: absolute; bottom: 90px; left: 0; right: 24px; font-size: 48px; -unity-font-style: bold; -unity-text-align: middle-center; }
.speech {
    position: absolute;
    top: 10px;
    right: 24px;
    left: 0;
    padding: 8px 14px;
    border-radius: 14px;
    border-bottom-left-radius: 3px;
    background-color: var(--gs-card);
    border-width: 1px;
    border-color: var(--gs-border);
    font-size: 16px;
    white-space: normal;
    max-width: 320px;
}
.mood-box { position: absolute; bottom: 16px; left: -60px; right: 24px; align-items: center; }
.mood { -unity-font-style: bold; font-size: 16px; padding: 3px 12px; border-radius: 9px; background-color: rgba(255, 255, 255, 0.92); }
.outfit { font-size: 12px; color: var(--gs-muted); margin-top: 3px; padding: 1px 8px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.85); }

/* 단계별 창 */
.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
    display: none;
}
.modal { width: 640px; max-height: 90%; padding: 24px; border-radius: 14px; background-color: var(--gs-card); }
.modal--wide { width: 980px; }
.modal-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 12px; }
.modal-body { margin-bottom: 12px; white-space: normal; }
.modal-button { height: 48px; font-size: 18px; border-radius: 8px; margin-top: 8px; }
.modal-button--sub { height: 40px; }

.picker-list { flex-direction: row; flex-wrap: wrap; }
.picker-button { width: 180px; height: 44px; margin: 4px; }

.settlement-summary { font-size: 17px; }
.repay-row { margin-top: 4px; }
.repay-field { width: 160px; margin-right: 6px; }
.message { min-height: 22px; }

.shop-cash { -unity-font-style: bold; }
.shop-list { max-height: 640px; }
.shop-row { flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 6px; border-radius: 8px; background-color: var(--gs-panel); }
.shop-info { flex-grow: 1; flex-shrink: 1; }
.shop-name { -unity-font-style: bold; }
.shop-desc { font-size: 14px; color: var(--gs-muted); white-space: normal; }
.shop-tag { font-size: 13px; padding: 1px 8px; border-radius: 6px; margin-left: 8px; background-color: rgba(55, 138, 221, 0.12); color: var(--gs-accent); }
.shop-price { width: 100px; -unity-text-align: middle-right; margin-right: 12px; -unity-font-style: bold; }
.shop-owned { width: 70px; -unity-text-align: middle-center; color: var(--gs-muted); font-size: 14px; }
.shop-buy { width: 90px; height: 40px; }

.end-portrait { height: 360px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.end-title { font-size: 34px; }

/* 타이틀 화면: 문구는 그림 오른쪽 아래 제목 "(※무리가 아니었다?!)"과 그래프 사이 */
.title-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #1B1033;
    background-image: url("../../Art/UI/title.png");
    -unity-background-scale-mode: scale-and-crop;
}
/* 위치·크기는 GameScreenController.LayoutTitle이 그림 기준으로 정한다 (화면 비율이 달라 그림이 잘려도 제목 밑에 오도록) */
.title-start {
    position: absolute;
    -unity-text-align: upper-center;
    -unity-font-style: normal;
    letter-spacing: 3px;
    color: #FFFFFF;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
    padding: 0;
    margin: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
}
.title-start--dim { opacity: 0.25; }

/* 하루 시작 전 뉴스 확인: 신문 그림 오른쪽 면(그림 폭 25~74%, 높이 21~92%) 안에 글을 둔다 */
.news-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
    background-color: #3A2418;
    background-image: url("../../Art/UI/news.png");
    -unity-background-scale-mode: scale-and-crop;
}
.news-paper {
    position: absolute;
    left: 28%;
    width: 43%;
    top: 22%;
    bottom: 10%;
    color: #3B2A20;
}
.news-paper-date { font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; color: #5A4030; margin-bottom: 14px; }
.news-paper-list { flex-grow: 1; }
.news-paper-item {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    color: #2E1F16;
    padding: 10px 4px;
    border-bottom-width: 1px;
    border-color: rgba(59, 42, 32, 0.35);
}
.news-paper-item--chain { color: #9C2A1E; }
.news-paper-note { font-size: 15px; color: #6B5040; white-space: normal; -unity-text-align: middle-center; margin: 8px 0; }
.news-paper-button {
    height: 52px;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 0;
    background-color: #3B2A20;
    color: #F6EBDD;
}
.news-paper-button:hover { background-color: #5A4030; }

/* 상점: 서류가방 그림 안쪽 붉은 천 부분(그림 폭 4~79%, 높이 31~83%) 안에 진열 */
.shop-overlay {
    background-color: #1A0B12;
    background-image: url("../../Art/UI/store.png");
    -unity-background-scale-mode: scale-and-crop;
}
/* 그림(1672×941)이 그려진 영역. 위치·크기는 GameScreenController.FitToImage가 정한다 */
.shop-stage { position: absolute; color: #F6E7D8; }

/* 가방 안감 위쪽 접힌 선 바로 아래: 제목과 현금 */
.shop-header {
    position: absolute;
    left: 12.1%; width: 60.1%; top: 30.5%; height: 4.5%;
    flex-direction: row; justify-content: space-between; align-items: center;
}
.shop-title { font-size: 22px; -unity-font-style: bold; color: #F6E7D8; }
.shop-cash { font-size: 20px; -unity-font-style: bold; color: #F2C14E; }

/* 2×4 칸: 위치는 코드(FloorPoint)에서 가방 바닥 원근에 맞춰 정한다 */
.shop-grid { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
/* 칸 모양(사다리꼴)·테두리·마우스 올림 색은 ShopSlotElement가 직접 그린다 */
.shop-slot { position: absolute; }
.shop-slot--poor { opacity: 0.45; }
.shop-slot-icon {
    position: absolute;
    top: 12%; bottom: 14%;
    -unity-background-scale-mode: scale-to-fit;
}
.shop-slot-count {
    position: absolute; right: 4px; bottom: 2px;
    font-size: 13px; color: #F2C14E; -unity-font-style: bold;
}
.shop-slot-name {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: #FFFFFF;
    white-space: nowrap;
    overflow: hidden;
}

/* 아래: 안내/메시지와 다음 날 버튼 */
.shop-footer {
    position: absolute;
    left: 12.1%; width: 60.1%; top: 77.5%; height: 5.5%;
    flex-direction: row; align-items: center; justify-content: space-between;
}
.shop-message { font-size: 15px; color: #E0C9B8; white-space: normal; flex-shrink: 1; }
.shop-next {
    width: 180px; height: 44px; font-size: 18px; -unity-font-style: bold;
    border-width: 0; border-radius: 8px;
    background-color: #F2C14E; color: #2A0E16;
}

/* 설명창: 마우스 포인터 옆, 반투명 (위치는 코드에서 포인터를 따라 정한다) */
.shop-tooltip {
    position: absolute;
    left: 0; top: 0;
    width: 420px;
    padding: 16px 20px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(242, 193, 78, 0.6);
    background-color: rgba(10, 3, 6, 0.82);
    display: none;
}
.shop-tip-name { font-size: 22px; -unity-font-style: bold; color: #FFFFFF; }
.shop-tip-tag { font-size: 13px; padding: 2px 8px; border-radius: 6px; background-color: rgba(242, 193, 78, 0.2); color: #F2C14E; }
.shop-tip-desc { font-size: 16px; color: #E0C9B8; white-space: normal; margin: 10px 0; }
.shop-tip-price { font-size: 18px; -unity-font-style: bold; color: #F2C14E; }
.shop-tip-owned { font-size: 14px; color: #E0C9B8; }

/* 추가 대출 버튼 (2단계에서만 켜짐) */
.loan-take { height: 26px; font-size: 13px; padding: 0 10px; margin-left: 8px; border-radius: 7px; }

/* 긴급 대출 */
.emergency { border-width: 3px; border-color: var(--gs-up); }
.emergency-title { color: var(--gs-up); }
.emergency-accept { background-color: var(--gs-up); color: #FFFFFF; }

/* 오늘의 흐름 (사이드) */
.flow-card { margin-top: 12px; padding: 10px 14px; }
.flow-card--focus { border-color: var(--gs-accent); border-width: 2px; }
.flow-line { font-size: 13px; white-space: normal; margin-bottom: 3px; color: var(--gs-text); }
.flow-line--done { color: var(--gs-good); }
.flow-line--todo { color: var(--gs-muted); }
.flow-line--warn { color: var(--gs-up); }
.item-slot--used { border-color: var(--gs-good); }

/* 하루 결과창 */
.settlement-modal { max-height: 92%; }
.settlement-report { max-height: 560px; margin-bottom: 8px; }
.report-headline { flex-direction: row; align-items: flex-end; margin-bottom: 10px; }
.report-big { font-size: 34px; -unity-font-style: bold; margin-right: 12px; }
.report-section { margin-top: 10px; padding: 8px 12px; border-radius: 10px; background-color: var(--gs-panel); }
.report-section-title { -unity-font-style: bold; font-size: 17px; margin-bottom: 6px; color: var(--gs-text); }
.report-row { flex-direction: row; align-items: center; padding: 2px 0; }
.report-row--head { border-bottom-width: 1px; border-color: var(--gs-border); margin-bottom: 2px; }
.report-cell { font-size: 16px; flex-grow: 1; flex-basis: 0; white-space: normal; }
.report-cell--name { flex-grow: 1.6; -unity-font-style: bold; }
.report-cell--num { -unity-text-align: middle-right; }
.report-cell--head { color: var(--gs-muted); -unity-font-style: bold; font-size: 14px; }
.report-note { font-size: 15px; color: var(--gs-text); white-space: normal; margin: 1px 0; }
/* 뉴스 결과 줄: 종목 | 기사(넓게, 왼쪽 정렬) | 실제 등락률 */
.report-row--news { padding: 4px 0; align-items: flex-start; }
.report-row--news .report-cell--name { flex-grow: 0; flex-basis: 110px; }
.report-cell--headline { flex-grow: 1; -unity-text-align: upper-left; margin: 0 12px; }
.report-cell--change { flex-grow: 0; flex-basis: 110px; -unity-text-align: upper-right; -unity-font-style: bold; }
.report-ok { color: var(--gs-good); -unity-font-style: bold; }
.report-bad { color: var(--gs-up); -unity-font-style: bold; }

/* 튜토리얼 */
.tutorial-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    display: none;
}
.tutorial-highlight {
    position: absolute;
    border-width: 3px;
    border-color: #F2C14E;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
}
.tutorial-box {
    position: absolute;
    width: 480px;
    padding: 16px 20px;
    border-radius: 14px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: #F2C14E;
    color: #2C2C2A;
}
.tutorial-step { font-size: 12px; color: #6B6A65; }
.tutorial-title { font-size: 20px; -unity-font-style: bold; margin: 2px 0 6px 0; }
.tutorial-text { font-size: 16px; white-space: normal; margin-bottom: 12px; }
.tutorial-skip { font-size: 13px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: #6B6A65; }
.tutorial-next { width: 110px; height: 38px; font-size: 16px; -unity-font-style: bold; border-width: 0; border-radius: 8px; background-color: #F2C14E; color: #2A0E16; }

/* ───────── 5영역 배치 (시안: 왼쪽 종목 · 가운데 주식 창+아이템 · 오른쪽 뉴스·힌트+주인공) ───────── */
/* 위 막대: 테두리 없는 한 줄 */
.top-bar { height: 64px; margin: 12px 16px 0 16px; padding: 0 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.top-day { font-size: 26px; margin-right: 14px; }
.steps { flex-grow: 0; flex-shrink: 1; width: 470px; }
.step { height: 34px; font-size: 14px; margin-right: 4px; }
.top-stats { flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center; margin-left: 12px; }
.top-stat { flex-direction: row; align-items: center; margin: 0 6px; }
.top-stat .caption { margin-right: 6px; }
.top-stat .status-value--big { font-size: 20px; }
.repay { width: 220px; margin-left: 12px; }

/* 몸통: 영역 사이 간격 12px, 영역마다 테두리 */
.body--areas { padding: 12px 16px 16px 16px; }
.area { border-width: 2px; border-color: var(--gs-border); border-radius: 14px; background-color: var(--gs-card); }
.area--warm { background-color: var(--gs-panel); }

/* 왼쪽: 종목 목록 전체 높이 */
.left-column { width: 21%; min-width: 240px; flex-shrink: 0; margin-right: 12px; padding: 12px 14px; }
.left-column .stock-list-panel { width: auto; flex-grow: 1; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }

/* 가운데: 주식 창(상세 카드) + 아이템 띠. 내용이 넓어도 양옆을 밀어내지 않게 줄어들 수 있게 */
.body--areas .main-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; padding: 0; margin-right: 12px; }
.stock-area { flex-grow: 1; min-height: 0; }
.stock-area .stock-list-panel { display: none; }
.stock-area .detail-panel { border-width: 2px; }
.body--areas .item-bar { margin-top: 12px; min-height: 92px; }

/* 오른쪽: 위 절반 뉴스·흐름·힌트, 아래 주인공 */
.body--areas .side-col { width: 20%; min-width: 300px; flex-shrink: 0; padding: 0; margin-right: 0; }
.side-top { flex-grow: 1; flex-basis: 0; margin-bottom: 12px; padding: 10px 12px; }
.side-news-list { margin-bottom: 6px; }
.side-news-line { font-size: 13px; white-space: normal; margin-bottom: 4px; color: #633806; }
.side-news-line--revealed { -unity-font-style: bold; }
.side-section { margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-color: var(--gs-border); }
.body--areas .flow-card { margin-top: 8px; padding: 8px 0 0 0; border-width: 0; border-top-width: 1px; background-color: rgba(0, 0, 0, 0); }
.body--areas .flow-card--focus { border-top-width: 2px; border-color: var(--gs-accent); }
.body--areas .hint-card { margin-top: 8px; padding: 8px 0 0 0; max-height: none; border-width: 0; border-top-width: 1px; border-color: var(--gs-border); background-color: rgba(0, 0, 0, 0); }
.body--areas .hint-list { max-height: 160px; }

/* 주인공 영역: 말풍선(위) · 그림(가운데) · 표정·옷(아래)을 위아래로 나눠 그림 위에 아무것도 겹치지 않게 */
.body--areas .character-area { flex-grow: 1; flex-basis: 0; margin-right: 0; overflow: hidden; flex-direction: column; padding: 8px; }
.body--areas .speech { position: relative; top: auto; left: auto; right: auto; max-width: none; font-size: 14px; flex-shrink: 0; align-self: flex-start; }
.body--areas .portrait { position: relative; left: auto; right: auto; top: auto; bottom: auto; flex-grow: 1; min-height: 0; margin: 4px 0; }
.body--areas .mood-box { position: relative; left: auto; right: auto; bottom: auto; flex-shrink: 0; }
.body--areas .face { position: relative; bottom: auto; right: auto; flex-grow: 1; }

/* ───────── 경고창 · 프롤로그 ───────── */
.intro-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #000000;
    display: none;
}
.warning-overlay {
    background-image: url("../../Art/Item/warning.png");
    -unity-background-scale-mode: scale-to-fit;
}
.prologue-overlay { background-color: #0E0B12; overflow: hidden; }
.prologue-stage { position: absolute; -unity-background-scale-mode: scale-to-fit; }
.prologue-page--1 { background-image: url("../../Art/Item/prologue_1.png"); }
.prologue-page--2 { background-image: url("../../Art/Item/prologue_2.png"); }
.prologue-cover {
    position: absolute;
    background-color: #0E0B12;
    transition-property: opacity;
    transition-duration: 0.45s;
}
.prologue-cover--open { opacity: 0; }
.intro-hint {
    position: absolute;
    left: 0; right: 0; bottom: 18px;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}
.intro-skip {
    position: absolute;
    right: 20px; top: 16px;
    height: 40px; width: 120px;
    font-size: 16px;
    border-width: 0; border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
}

/* 아이템 칸 그림 (대출1·2 그림은 아이템 "무"·"콩팥"이 됨) */
.emergency-art { display: none; }
.item-slot { flex-direction: row; align-items: center; }
.item-slot__icon { width: 44px; height: 44px; margin-right: 6px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.item-slot__text { flex-grow: 1; flex-shrink: 1; }

/* 상점 5단계 배치 수정: 현금 = 가방 맨 위 가운데, 다음 날 = 화면 오른쪽 위 큰 버튼, 상점 제목 글자 없음 */
.shop-header {
    left: 27%; width: 30%; top: 7.5%; height: 9%;
    flex-direction: column; justify-content: center; align-items: center;
}
.shop-cash {
    font-size: 30px; -unity-font-style: bold; color: #F2C14E;
    padding: 4px 22px; border-radius: 14px;
    background-color: rgba(15, 4, 8, 0.72);
    border-width: 1px; border-color: rgba(242, 193, 78, 0.6);
}
.shop-message { font-size: 15px; color: #F6E7D8; margin-top: 4px; -unity-text-align: middle-center; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); }
.shop-next {
    position: absolute;
    right: 28px; top: 24px;
    width: 280px; height: 84px;
    font-size: 30px; -unity-font-style: bold;
    border-width: 2px; border-color: #FFFFFF; border-radius: 14px;
    background-color: #F2C14E; color: #2A0E16;
}
.shop-next:hover { background-color: #FFD56B; }

/* ───────── 화면 개선 (업종 접기 · 아이템 띠 두 칸 너비 · 주인공 크게 · 빚 상환 빨강) ───────── */
/* 왼쪽 [업종 | 주식 창] 줄, 그 아래 아이템 띠가 두 칸 너비 */
.main-top { flex-grow: 1; flex-direction: row; min-height: 0; }
.left-column { width: 13%; min-width: 170px; }
.main-top .stock-area { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.stock-group {
    font-size: 15px; color: var(--gs-text); -unity-font-style: bold; white-space: normal;
    margin: 4px 0; padding: 8px 8px; border-radius: 8px; background-color: var(--gs-panel);
}
.stock-group:hover { background-color: #E4E1D6; }
.stock-group--open { background-color: rgba(55, 138, 221, 0.14); color: #185FA5; }

/* 빚 상환 게이지: 글씨·숫자 빨강 */
.repay-text { color: var(--gs-up); -unity-font-style: bold; }
.repay-fill { background-color: var(--gs-up); }

/* 주인공: 말풍선 없이 더 크게 */
.body--areas .speech { display: none; }
.body--areas .side-top { flex-grow: 0.8; }
.body--areas .character-area { flex-grow: 1.25; padding: 0; }
.body--areas .portrait { margin: 0; }

/* 추가 대출 금액 입력 */
.loan-row { margin: 6px 0 4px 0; }
.loan-field { width: 220px; margin-right: 6px; }

/* 장 결과: 이자 갚기(왼쪽) · 빚 갚기(오른쪽) */
.pay-row { flex-direction: row; margin-top: 6px; }
.pay-box { flex-grow: 1; flex-basis: 0; padding: 8px 12px; border-radius: 10px; background-color: var(--gs-panel); }
.pay-box--interest { margin-right: 10px; border-width: 2px; border-color: #F2C14E; }
.pay-box-title { -unity-font-style: bold; font-size: 15px; margin-bottom: 4px; }
.pay-box .row { flex-wrap: wrap; }
.pay-box .repay-field { width: 170px; }

/* 상점: 흐리지 않게, 칸·그림·글씨 크게 */
.shop-slot--poor { opacity: 1; }
.shop-slot-icon { top: 4%; bottom: 4%; }
.shop-slot-name { font-size: 20px; text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9); }
.shop-slot-count { font-size: 15px; }
.shop-tooltip { width: 480px; }
.shop-tip-name { font-size: 24px; }
.shop-tip-desc { font-size: 18px; }
.shop-message { max-width: 520px; white-space: normal; }

/* 엔딩: 그림이 순서대로, 다 보면 다시 하기 */
.ending-overlay { background-color: #000000; overflow: hidden; }
.ending-stage { position: absolute; -unity-background-scale-mode: scale-to-fit; }
.ending-bankrupt-1 { background-image: url("../../Art/Ending/파산1.png"); }
.ending-bankrupt-2 { background-image: url("../../Art/Ending/파산2.png"); }
.ending-bankrupt-3 { background-image: url("../../Art/Ending/파산3.png"); }
.ending-success-1 { background-image: url("../../Art/Ending/성공1.png"); }
.ending-success-2 { background-image: url("../../Art/Ending/성공2.png"); }
.ending-success-3 { background-image: url("../../Art/Ending/성공3.png"); }
.ending-success-4 { background-image: url("../../Art/Ending/성공4.png"); }
/* 파산2 말풍선 "드디어 [n]억 돌파!"의 빈 자리 (그림 1672×941 기준) */
.ending-amount {
    position: absolute; left: 22%; top: 16.5%; width: 10%; height: 11%;
    -unity-text-align: middle-right; -unity-font-style: bold; color: #C8103E; padding: 0; margin: 0;
    font-size: 64px; display: none;
}
.ending-end {
    position: absolute; left: 0; right: 0; bottom: 6%;
    align-items: center; display: none;
}
.ending-summary {
    font-size: 22px; color: #FFFFFF; -unity-text-align: middle-center; white-space: normal;
    padding: 8px 18px; margin-bottom: 10px; border-radius: 10px; background-color: rgba(0, 0, 0, 0.6);
}
.ending-restart {
    width: 280px; height: 72px; font-size: 28px; -unity-font-style: bold;
    border-width: 2px; border-color: #FFFFFF; border-radius: 14px;
    background-color: #F2C14E; color: #2A0E16;
}
.ending-restart:hover { background-color: #FFD56B; }

/* 왼쪽 업종 칸 조금 넓게, 오른쪽 열 넓혀 주인공 크게 (그림 양옆 빈 곳은 잘라 꽉 차게) */
.left-column { width: 15%; min-width: 200px; }
.body--areas .side-col { width: 22%; min-width: 330px; }
.body--areas .portrait { -unity-background-scale-mode: scale-and-crop; background-position-y: bottom; background-position-x: center; }

/* 주인공: 네모 칸 없이 오른쪽 아래 화면 끝까지, 그림을 더 크게 (잘림 없이 높이에 맞춤, 왼쪽으로 넘쳐도 됨) */
.body--areas .side-top { flex-grow: 0.62; }
.body--areas .character-area {
    flex-grow: 1.4; padding: 0; overflow: visible;
    border-width: 0; background-color: rgba(0, 0, 0, 0);
    margin-right: -16px; margin-bottom: -16px;
}
.body--areas .portrait {
    position: absolute; top: 0; bottom: 0; right: 0; left: -90px; margin: 0;
    -unity-background-scale-mode: scale-to-fit; background-position-x: right; background-position-y: bottom;
}
.body--areas .mood-box { position: absolute; left: 0; right: 0; bottom: 18px; }

/* 종목마다 이름·가격·등락을 한 상자로 (테두리) */
.left-column .stock-item {
    margin: 4px 0 4px 6px; padding: 7px 9px;
    border-width: 1px; border-color: var(--gs-border); border-radius: 8px;
    background-color: #FFFFFF;
}
.left-column .stock-item:hover { background-color: #F7F6F1; }
.left-column .stock-item--selected { border-width: 2px; border-color: var(--gs-accent); background-color: rgba(55, 138, 221, 0.08); }

/* 햇살론 창 */
.emergency-sub { color: var(--gs-up); -unity-font-style: bold; font-size: 16px; margin-bottom: 8px; }

/* 상점 다음 날 버튼 = 그림 (Art/UI/next_day.png = 이미지/5단계_엔딩.png, 2172×724) */
.shop-next {
    width: 360px; height: 120px; right: 20px; top: 16px;
    border-width: 0; background-color: rgba(0, 0, 0, 0);
    background-image: url("../../Art/UI/next_day.png"); -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.shop-next:hover { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: #FFF4C2; scale: 1.04 1.04; }
.shop-next:active { scale: 0.97 0.97; }

/* 프롤로그: 새 장으로 바꿀 때 가림막을 즉시 덮는다 (전체 그림이 잠깐 보이는 문제) */
.prologue-cover--instant { transition-duration: 0s; }

/* 상점 다음 날 버튼: 오른쪽 아래 캐릭터(탐정) 아래쪽 */
.shop-next { top: auto; bottom: 14px; right: 16px; width: 330px; height: 110px; }

/* 파산 엔딩 4: 어두운 배경 가운데 그림 + 경고 문구 */
.ending-final {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: #07060A; align-items: center; justify-content: center; display: none;
    padding-bottom: 120px;
}
.ending-final-image { width: 52%; height: 58%; background-image: url("../../Art/Ending/파산4.png"); -unity-background-scale-mode: scale-to-fit; }
.ending-final-text {
    margin-top: 26px; font-size: 26px; color: #E8E2D8; -unity-text-align: middle-center; white-space: normal;
    max-width: 80%;
}

/* 뉴스: 4개를 한 칸씩 상자로, 글자 조금 크게 (1단계 신문 · 오른쪽 위 목록) */
.news-paper-item {
    font-size: 27px; padding: 14px 18px; margin-bottom: 12px;
    border-width: 2px; border-color: rgba(59, 42, 32, 0.45); border-radius: 10px;
    background-color: rgba(255, 250, 240, 0.55);
}
.side-news-line {
    font-size: 14px; padding: 6px 8px; margin-bottom: 6px;
    border-width: 1px; border-color: #E2C9A0; border-radius: 8px; background-color: #FFF8EC;
}

/* 왼쪽 맨 위: 보유 중인 종목 상자 */
.held-box {
    margin: 0 0 8px 0; padding: 6px 4px 4px 0;
    border-width: 2px; border-color: #378ADD; border-radius: 10px; background-color: rgba(55, 138, 221, 0.06);
}
.held-box-title { font-size: 14px; -unity-font-style: bold; color: #185FA5; margin: 0 0 2px 8px; }

/* 오른쪽 위 상자를 아래로 조금 길게. 주인공 그림은 위로 넘쳐도 크기 그대로 */
.body--areas .side-top { flex-grow: 0.8; }
.body--areas .portrait { top: -70px; }

/* 망원경 창: 화면 위쪽 가운데 */
.telescope-panel {
    position: absolute; left: 30%; width: 40%; top: 90px; height: 230px;
    padding: 10px 14px; border-radius: 12px; border-width: 2px; border-color: #F2C14E;
    background-color: rgba(20, 14, 6, 0.92); display: none;
}
.telescope-title { color: #F2C14E; -unity-font-style: bold; font-size: 16px; margin-bottom: 4px; }
.telescope-chart { flex-grow: 1; }

/* 파산 경보: 빨간 테두리 + 큰 글씨, 깜빡임 */
.alarm-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    border-width: 14px; border-color: #FF1E1E; background-color: rgba(255, 0, 0, 0.12);
    align-items: center; justify-content: center; display: none;
    transition-property: opacity; transition-duration: 0.15s;
}
.alarm-overlay--dim { opacity: 0.25; }
.alarm-text {
    font-size: 64px; -unity-font-style: bold; color: #FFFFFF;
    background-color: rgba(200, 0, 0, 0.85); padding: 10px 40px; border-radius: 16px;
}

/* 아이템 칸: 긴 이름이 칸을 벗어나지 않게 (칸 넓히고 글자 줄이고 줄바꿈) */
.item-slot { width: 200px; min-height: 64px; height: auto; margin-bottom: 4px; }
.item-slot__name { font-size: 13px; white-space: normal; -unity-text-align: middle-left; }
.item-slot__meta { font-size: 11px; -unity-text-align: middle-left; }
.shop-slot-name { font-size: 15px; white-space: normal; overflow: hidden; }

/* 왼쪽 목록 조금 넓게, 종목 상자 안 글자 조금 작게 (등락률이 잘리지 않게) */
.left-column { width: 16%; min-width: 215px; }
.left-column .stock-item { padding: 6px 7px; margin-left: 2px; }
.left-column .stock-item__name { font-size: 15px; }
.left-column .stock-item__price, .left-column .stock-item__change { font-size: 13px; }

/* 오늘 이미 산 아이템 (하루에 아이템당 1개) */
.shop-slot--sold { opacity: 0.4; }
/* 장 화면 아이템 띠 설명창 */
.item-tooltip { width: 420px; }
