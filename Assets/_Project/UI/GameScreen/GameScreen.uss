/* 하루 루프 전체 화면. 가운데 주식 창은 StockWindow.uxml/uss를 그대로 쓴다. */
.game-screen {
    --gs-bg: #FFFFFF;
    --gs-panel: #F1EFE8;
    --gs-border: #D3D1C7;
    --gs-text: #2C2C2A;
    --gs-muted: #5F5E5A;
    --gs-accent: #378ADD;
    --gs-up: #E24B4A;
    --gs-down: #378ADD;

    flex-grow: 1;
    background-color: var(--gs-bg);
    color: var(--gs-text);
    font-size: 18px;
}

.row { flex-direction: row; align-items: center; }
.row--spread { justify-content: space-between; }
.caption { font-size: 15px; color: var(--gs-muted); margin-right: 6px; }
.price-up { color: var(--gs-up); }
.price-down { color: var(--gs-down); }

/* 위 막대 */
.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 24px;
    border-bottom-width: 1px;
    border-color: var(--gs-border);
}
.top-day { font-size: 22px; -unity-font-style: bold; margin-right: 12px; }
.top-phase {
    font-size: 15px;
    padding: 2px 10px;
    border-radius: 8px;
    background-color: rgba(55, 138, 221, 0.12);
    color: var(--gs-accent);
}
.top-spacer { flex-grow: 1; }
.top-value { -unity-font-style: bold; margin-right: 12px; }
.top-debt { color: var(--gs-up); }
.top-gap { margin-right: 16px; }

/* 가운데 */
.main-row { flex-grow: 1; flex-direction: row; }
.stock-window-host { flex-grow: 1; }

.side-panel { width: 340px; padding: 24px 24px 24px 0; }
.side-card { padding: 12px; border-radius: 8px; background-color: var(--gs-panel); margin-bottom: 12px; }
.side-card--grow { flex-grow: 1; }
.side-title { -unity-font-style: bold; font-size: 16px; margin-bottom: 6px; }
.side-title--gap { margin-top: 12px; }
.news-line { font-size: 14px; white-space: normal; margin-bottom: 6px; }
.hint-list { flex-grow: 1; }
.hint-line { font-size: 13px; white-space: normal; margin-bottom: 4px; color: var(--gs-muted); }

.character-cam { align-items: center; margin-bottom: 0; }
.portrait { width: 100%; height: 300px; -unity-background-scale-mode: scale-to-fit; }
.end-portrait { height: 360px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.face { font-size: 40px; -unity-font-style: bold; margin: 8px 0; }
.mood { -unity-font-style: bold; margin-bottom: 4px; }

/* 아래 아이템 막대 */
.item-bar {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    padding: 8px 24px;
    border-top-width: 1px;
    border-color: var(--gs-border);
}
.item-bar-title { -unity-font-style: bold; margin-right: 12px; }
.item-bar-list { flex-direction: row; flex-wrap: wrap; }
.item-bar-hint { margin-left: auto; white-space: normal; max-width: 520px; }
.item-chip { height: 40px; font-size: 15px; border-radius: 8px; margin-right: 6px; }
.item-chip--off { opacity: 0.4; }

/* 단계별 창 */
.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
    display: none;
}
.modal {
    width: 640px;
    max-height: 90%;
    padding: 24px;
    border-radius: 12px;
    background-color: var(--gs-bg);
}
.modal--wide { width: 980px; }
.modal-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 12px; }
.modal-body { margin-bottom: 12px; white-space: normal; }
.modal-button { height: 48px; font-size: 18px; border-radius: 8px; margin-top: 8px; }
.modal-button--sub { height: 40px; }
.news-card { padding: 10px 12px; border-radius: 8px; background-color: var(--gs-panel); margin-bottom: 8px; white-space: normal; }
.news-card--chain { border-left-width: 4px; border-color: #BA7517; }

.picker-list { flex-direction: row; flex-wrap: wrap; }
.picker-button { width: 180px; height: 44px; margin: 4px; }

.settlement-summary { font-size: 17px; }
.repay-row { margin-top: 4px; }
.repay-field { width: 160px; margin-right: 6px; }
.message { min-height: 22px; }

.shop-cash { -unity-font-style: bold; }
.shop-list { max-height: 640px; }
.shop-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: var(--gs-panel);
}
.shop-info { flex-grow: 1; flex-shrink: 1; }
.shop-name { -unity-font-style: bold; }
.shop-desc { font-size: 14px; color: var(--gs-muted); white-space: normal; }
.shop-tag { font-size: 13px; padding: 1px 8px; border-radius: 6px; margin-left: 8px; background-color: rgba(55, 138, 221, 0.12); color: var(--gs-accent); }
.shop-price { width: 100px; -unity-text-align: middle-right; margin-right: 12px; -unity-font-style: bold; }
.shop-owned { width: 70px; -unity-text-align: middle-center; color: var(--gs-muted); font-size: 14px; }
.shop-buy { width: 90px; height: 40px; }

.end-title { font-size: 34px; }
