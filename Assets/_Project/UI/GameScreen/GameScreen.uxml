<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="StockWindow" src="../StockWindow/StockWindow.uxml" />
    <Style src="GameScreen.uss" />
    <ui:VisualElement name="game-screen" class="game-screen">

        <!-- 위: 테두리 없는 한 줄 상태 막대 (일차 · 단계 · 현금 · 빚 · 이자 · 추가 대출 · 순자산 · 빚 상환 게이지) -->
        <ui:VisualElement class="top-bar">
            <ui:Label name="day-label" text="DAY 1" class="top-day" />
            <ui:VisualElement class="steps">
                <ui:Label name="step-1" text="뉴스" class="step" />
                <ui:Label name="step-2" text="아이템" class="step" />
                <ui:Label name="step-3" text="장 · 60초" class="step" />
                <ui:Label name="step-4" text="결과" class="step" />
                <ui:Label name="step-5" text="상점" class="step" />
            </ui:VisualElement>
            <ui:VisualElement class="top-stats">
                <ui:VisualElement class="top-stat"><ui:Label text="현금" class="caption" /><ui:Label name="cash-label" class="status-value" /></ui:VisualElement>
                <ui:VisualElement class="top-stat"><ui:Label text="주식 평가" class="caption" /><ui:Label name="stock-value-label" class="status-value" /></ui:VisualElement>
                <ui:VisualElement class="top-stat"><ui:Label text="다음 이자" class="caption" /><ui:Label name="interest-label" class="chip chip--warning" /></ui:VisualElement>
                <ui:VisualElement class="top-stat"><ui:Label text="추가 대출" class="caption" /><ui:Label name="loan-count-label" class="status-value status-value--small" /><ui:Button name="loan-button" text="받기" class="loan-take" tooltip="추가 대출은 아이템 시간·장 시간에, 한 판에 1번, 최대 2억" /></ui:VisualElement>
                <ui:VisualElement class="top-stat"><ui:Label text="순자산" class="caption" /><ui:Label name="networth-label" class="status-value status-value--big" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="repay">
                <ui:VisualElement class="row row--spread">
                    <ui:Label text="빚 상환" class="caption repay-text" />
                    <ui:Label name="repay-label" text="0원 / 1억원" class="caption repay-text" />
                </ui:VisualElement>
                <ui:VisualElement class="repay-track">
                    <ui:VisualElement name="repay-fill" class="repay-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 몸통: 왼쪽 [종목(업종) | 주식 창] 아래로 아이템 띠가 두 칸 너비 | 오른쪽 뉴스·흐름·힌트 + 주인공 -->
        <ui:VisualElement class="body body--areas">
            <ui:VisualElement class="main-col">
                <ui:VisualElement class="main-top">
                    <!-- 왼쪽: 업종 목록 (주식 창과 같은 높이). StockWindow.uxml의 stock-list-panel을 GameScreenController가 여기로 옮긴다 -->
                    <ui:VisualElement name="left-column" class="area left-column" />
                    <ui:VisualElement class="stock-area">
                        <ui:Instance template="StockWindow" class="stock-window-host" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="item-bar area">
                    <ui:Label text="아이템" class="item-bar-title" />
                    <ui:VisualElement name="item-bar-list" class="item-bar-list" />
                    <ui:Label name="item-bar-hint" class="caption item-bar-hint" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 오른쪽: 위 = 오늘의 뉴스 · 오늘의 흐름 · 힌트, 아래 = 주인공 -->
            <ui:VisualElement class="side-col">
                <ui:ScrollView name="side-top" class="area area--warm side-top">
                    <ui:Label text="오늘의 뉴스" class="side-title" />
                    <ui:VisualElement name="side-news-list" class="side-news-list" />

                    <!-- 오늘의 흐름: 지금까지 한 일과 아이템 사용 여부 (2단계에서 강조) -->
                    <ui:VisualElement name="flow-card" class="flow-card side-section">
                        <ui:Label text="오늘의 흐름" class="side-title" />
                        <ui:VisualElement name="flow-list" />
                    </ui:VisualElement>

                    <ui:VisualElement name="hint-card" class="hint-card side-section">
                        <ui:Label text="받은 힌트 · 사용 중 효과" class="side-title" />
                        <ui:ScrollView name="hint-list" class="hint-list" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <!-- 주인공: 그림은 CharacterSettings, 그림이 없으면 글자 얼굴 -->
                <ui:VisualElement name="character-area" class="character-area" picking-mode="Ignore">
                    <ui:Label name="speech-label" text="오늘은 뭘 살까~?" class="speech" />
                    <ui:VisualElement name="portrait" class="portrait" picking-mode="Ignore" />
                    <ui:Label name="face-label" text="(-_-)" class="face" />
                    <ui:VisualElement class="mood-box" picking-mode="Ignore">
                        <ui:Label name="mood-label" text="보합 · 오늘 +0.00%" class="mood" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 뉴스 띠: 실행 중 주식 창 오른쪽(차트 위)으로 옮겨 붙인다 -->
        <ui:VisualElement name="news-band" class="news-band">
            <ui:VisualElement class="row row--spread">
                <ui:Label name="news-band-title" text="오늘의 뉴스" class="news-band-title" />
                <ui:Button name="news-confirm-button" text="확인 · 아이템 단계로" class="news-confirm" />
            </ui:VisualElement>
            <ui:VisualElement name="news-band-list" />
        </ui:VisualElement>

        <!-- 하루 시작 전 뉴스 확인: 신문 그림(Art/UI/news.png) 오른쪽 면에 뉴스를 적는다 -->
        <ui:VisualElement name="news-overlay" class="news-overlay">
            <ui:VisualElement class="news-paper">
                <ui:Label name="news-paper-date" text="1일차 아침" class="news-paper-date" />
                <ui:ScrollView name="news-paper-list" class="news-paper-list" />
                <ui:Button name="news-paper-button" text="확인 · 아이템 단계로" class="news-paper-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 단계별 창 -->
        <ui:VisualElement name="picker-overlay" class="overlay">
            <ui:VisualElement class="modal">
                <ui:Label name="picker-title" text="종목 선택" class="modal-title" />
                <ui:VisualElement name="picker-list" class="picker-list" />
                <ui:Button name="picker-cancel-button" text="취소" class="modal-button modal-button--sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settlement-overlay" class="overlay">
            <ui:VisualElement class="modal modal--wide settlement-modal">
                <ui:Label name="settlement-title" text="1일차 장 결과" class="modal-title" />
                <!-- 하루 결과: 손익 요약 · 종목별 · 아이템 · 뉴스 · 대출 (GameScreenController.RefreshSettlement가 채움) -->
                <ui:ScrollView name="settlement-report" class="settlement-report" />
                <ui:Label name="settlement-summary" class="caption settlement-summary" />
                <!-- 왼쪽 이자 갚기 (3일차부터) · 오른쪽 빚 갚기 -->
                <ui:VisualElement class="pay-row">
                    <ui:VisualElement name="interest-box" class="pay-box pay-box--interest">
                        <ui:Label text="이자 갚기" class="pay-box-title" />
                        <ui:Label name="interest-due-label" class="caption" />
                        <ui:Button name="interest-pay-button" text="이자 갚기" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pay-box">
                        <ui:Label text="빚 갚기" class="pay-box-title" />
                        <ui:VisualElement class="row">
                            <ui:FloatField name="repay-field" value="0" class="repay-field" />
                            <ui:Label text="만원" class="caption" />
                            <ui:Button name="repay-button" text="빚 갚기" />
                            <ui:Button name="repay-all-button" text="현금 전부" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="settlement-message" class="caption message" />
                <ui:Button name="to-shop-button" text="상점으로" class="modal-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 긴급 대출: 장 마감 정산 후 잔고가 0 밑일 때, 4단계 직전에 한 판에 한 번 -->
        <ui:VisualElement name="emergency-overlay" class="overlay">
            <ui:VisualElement class="modal emergency">
                <ui:VisualElement class="emergency-art" picking-mode="Ignore" />
                <ui:Label text="햇살론 대출하시겠습니까?" class="modal-title emergency-title" />
                <ui:Label text="잔고 부족 · 이대로면 파산!" class="caption emergency-sub" />
                <ui:Label name="emergency-body" class="modal-body" />
                <ui:Button name="emergency-accept-button" text="네, 대출받을게요" class="modal-button emergency-accept" />
                <ui:Button name="emergency-decline-button" text="아니요… (파산)" class="modal-button modal-button--sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 상점: 서류가방 그림(Art/UI/store.png). shop-stage는 그림이 실제로 그려진 영역에 맞춰지고, 안쪽은 그림 기준 %로 배치한다 -->
        <ui:VisualElement name="shop-overlay" class="overlay shop-overlay">
            <ui:VisualElement name="shop-stage" class="shop-stage">
                <!-- 현금: 가방 맨 위쪽 가운데, 그 밑에 구매 메시지 -->
                <ui:VisualElement class="shop-header">
                    <ui:Label name="shop-cash" text="현금 $0.00" class="shop-cash" />
                    <ui:Label name="shop-message" class="shop-message" />
                </ui:VisualElement>
                <ui:VisualElement name="shop-grid" class="shop-grid" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- 다음 날: 화면 오른쪽 위, 크게 -->
            <ui:Button name="next-day-button" text="" tooltip="다음날로 넘어가기" class="shop-next" />
            <!-- 마우스를 올린 아이템 설명: 화면 가운데 반투명 창 -->
            <ui:VisualElement name="shop-tooltip" class="shop-tooltip" picking-mode="Ignore">
                <ui:VisualElement class="row row--spread" picking-mode="Ignore">
                    <ui:Label name="shop-tip-name" class="shop-tip-name" picking-mode="Ignore" />
                    <ui:Label name="shop-tip-tag" class="shop-tip-tag" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="shop-tip-desc" class="shop-tip-desc" picking-mode="Ignore" />
                <ui:VisualElement class="row row--spread" picking-mode="Ignore">
                    <ui:Label name="shop-tip-price" class="shop-tip-price" picking-mode="Ignore" />
                    <ui:Label name="shop-tip-owned" class="shop-tip-owned" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 엔딩: 파산(Art/Ending/파산1~3) · 성공(성공1~4) 그림이 클릭할 때마다 순서대로, 다 보면 다시 하기 -->
        <ui:VisualElement name="end-overlay" class="intro-overlay ending-overlay">
            <ui:VisualElement name="ending-stage" class="ending-stage" picking-mode="Ignore">
                <ui:Label name="ending-amount" class="ending-amount" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- 파산 4: 어두운 배경 가운데 그림 + 경고 문구 -->
            <ui:VisualElement name="ending-final" class="ending-final" picking-mode="Ignore">
                <ui:VisualElement class="ending-final-image" picking-mode="Ignore" />
                <ui:Label text="과도한 투자는 심각한 경제적 손실과 감당할 수 없는 채무를 초래할 수 있습니다" class="ending-final-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="ending-hint" text="클릭하면 다음" class="intro-hint" picking-mode="Ignore" />
            <ui:VisualElement name="ending-end" class="ending-end">
                <ui:Label name="ending-summary" class="ending-summary" />
                <ui:Button name="restart-button" text="다시 하기" class="ending-restart" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 추가 대출: 한 판에 1번, 최대 2억 (2단계에서만) -->
        <ui:VisualElement name="loan-overlay" class="overlay">
            <ui:VisualElement class="modal">
                <ui:Label text="추가 대출" class="modal-title" />
                <ui:Label name="loan-body" class="modal-body" />
                <ui:VisualElement class="row loan-row">
                    <ui:FloatField name="loan-field" value="200000000" class="loan-field" />
                    <ui:Label text="원" class="caption" />
                </ui:VisualElement>
                <ui:Button name="loan-confirm-button" text="빌리기" class="modal-button" />
                <ui:Button name="loan-cancel-button" text="취소" class="modal-button modal-button--sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 망원경: 고른 종목의 앞으로 몇 초 가격 (장 중, 따로 창) -->
        <ui:VisualElement name="telescope-panel" class="telescope-panel" picking-mode="Ignore">
            <ui:Label name="telescope-title" class="telescope-title" picking-mode="Ignore" />
            <BurningAnt.UI.PriceChartElement name="telescope-chart" class="telescope-chart" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 파산 경보기: 울리면 화면 테두리가 빨갛게 깜빡인다 -->
        <ui:VisualElement name="alarm-overlay" class="alarm-overlay" picking-mode="Ignore">
            <ui:Label name="alarm-text" text="파산 경보!" class="alarm-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 튜토리얼: 1일차 각 단계에서 설명 + 대상 강조 (TutorialRunner) -->
        <ui:VisualElement name="tutorial-overlay" class="tutorial-overlay">
            <ui:VisualElement name="tutorial-highlight" class="tutorial-highlight" picking-mode="Ignore" />
            <ui:VisualElement name="tutorial-box" class="tutorial-box">
                <ui:Label name="tutorial-step" class="tutorial-step" />
                <ui:Label name="tutorial-title" class="tutorial-title" />
                <ui:Label name="tutorial-text" class="tutorial-text" />
                <ui:VisualElement class="row row--spread tutorial-buttons">
                    <ui:Button name="tutorial-skip" text="튜토리얼 건너뛰기" class="tutorial-skip" />
                    <ui:Button name="tutorial-next" text="다음" class="tutorial-next" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 타이틀: 게임 시작 시 맨 위에 덮여 있다가 클릭하면 사라진다 -->
        <ui:VisualElement name="title-overlay" class="title-overlay">
            <ui:Label name="title-start" text="클릭하여 시작하기" class="title-start" />
        </ui:VisualElement>

        <!-- 프롤로그: 그림 2장(Art/Item/prologue_1·2), 한 장에 3컷이 순서대로 하나씩 드러난다 (가림막이 하나씩 걷힘) -->
        <ui:VisualElement name="prologue-overlay" class="intro-overlay prologue-overlay">
            <ui:VisualElement name="prologue-stage" class="prologue-stage">
                <ui:VisualElement name="prologue-cover-0" class="prologue-cover" picking-mode="Ignore" />
                <ui:VisualElement name="prologue-cover-1" class="prologue-cover" picking-mode="Ignore" />
                <ui:VisualElement name="prologue-cover-2" class="prologue-cover" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="prologue-hint" text="클릭하면 다음 컷" class="intro-hint" />
            <ui:Button name="prologue-skip" text="건너뛰기" class="intro-skip" />
        </ui:VisualElement>

        <!-- 경고창: 실행하면 가장 먼저 (Art/Item/warning.png) -->
        <ui:VisualElement name="warning-overlay" class="intro-overlay warning-overlay">
            <ui:Label name="warning-hint" text="클릭하여 계속" class="intro-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
